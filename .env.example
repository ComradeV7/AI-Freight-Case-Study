# Copy this file to .env (gitignored) if you want a local reminder of the
# required variables — but note the pipeline does NOT read .env.
#
# The API key is read ONLY from the LLM_API_KEY environment variable:
#
#   PowerShell:  $env:LLM_API_KEY = "gsk_your_key_here"
#   Bash:        export LLM_API_KEY=gsk_your_key_here
#
# Never commit a real key to this repository.

LLM_API_KEY=gsk_replace_me_with_your_real_key
